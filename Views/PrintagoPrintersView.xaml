<UserControl x:Class="PrintagoManager.Views.PrintagoPrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PrintagoManager.Views"
             xmlns:viewModels="clr-namespace:PrintagoManager.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:MainViewModel, IsDesignTimeCreatable=True}">
    <Grid>
        <!-- Assuming parent Grid provides background from App.xaml style -->
        <StackPanel>
            <TextBlock Text="Printago Store Printers" FontSize="18" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="{Binding PrintagoStatus}" Margin="5,0,5,5" Foreground="LightCoral"/>
            <Button Content="Refresh Printers" Command="{Binding LoadPrintagoPrintersCommand}" Margin="5" HorizontalAlignment="Left"/>
            <ListView ItemsSource="{Binding PrintagoPrinters}" BorderThickness="0" MaxHeight="400">
                <!-- Background and Foreground will be inherited or set by App.xaml styles -->
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                        <GridViewColumn Header="Provider" DisplayMemberBinding="{Binding Provider}" Width="100"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusDisplay}" Width="100"/>
                        <GridViewColumn Header="Model" DisplayMemberBinding="{Binding DeviceModel}" Width="150"/>
                        <!-- Add more columns as needed -->
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
