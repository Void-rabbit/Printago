/* Dark Theme for Printago Manager */

/* Overall Window and Base Widget Styling */
QMainWindow, QDialog {
    background-color: #2d2d2d; /* Dark gray background */
    color: #f0f0f0; /* Light gray text */
}

QWidget {
    background-color: #2d2d2d;
    color: #f0f0f0;
    border: none; /* Remove borders from generic QWidgets unless specified */
}

/* Labels */
QLabel {
    color: #f0f0f0; /* Light text for labels */
    background-color: transparent; /* Ensure labels don't have their own background unless intended */
}

/* LineEdits (Input Fields) */
QLineEdit {
    background-color: #3c3c3c; /* Slightly lighter dark gray */
    color: #f0f0f0;
    border: 1px solid #555555; /* Subtle border */
    border-radius: 4px;
    padding: 5px;
    font-size: 10pt; /* Consistent font size */
}
QLineEdit:focus {
    border: 1px solid #007bff; /* Printago blue accent on focus */
}
QLineEdit:read-only {
    background-color: #333333;
}


/* Buttons */
QPushButton {
    background-color: #007bff; /* Printago blue for primary buttons */
    color: #ffffff; /* White text on buttons */
    border: 1px solid #0069d9;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 10pt;
    min-width: 80px; /* Minimum width for buttons */
}
QPushButton:hover {
    background-color: #0069d9; /* Darker blue on hover */
    border-color: #0056b3;
}
QPushButton:pressed {
    background-color: #0056b3; /* Even darker blue when pressed */
}
QPushButton:disabled {
    background-color: #4a4a4a;
    color: #888888;
    border-color: #555555;
}

/* QDialogButtonBox specific button styling */
QDialogButtonBox QPushButton {
    /* You can add more specific styling if needed, e.g., different default button color */
    /* background-color: #555555; */ /* Example: Gray buttons in dialogs */
}


/* Table Widget */
QTableWidget {
    background-color: #3c3c3c;
    color: #f0f0f0;
    border: 1px solid #444444;
    gridline-color: #444444; /* Color of the grid lines */
    selection-background-color: #007bff; /* Blue selection */
    selection-color: #ffffff;
    font-size: 10pt;
}
QTableWidget::item {
    padding: 5px;
}
QHeaderView::section {
    background-color: #4a4a4a; /* Darker header background */
    color: #f0f0f0;
    padding: 5px;
    border: 1px solid #555555;
    font-size: 10pt;
    font-weight: bold;
}
QTableCornerButton::section { /* Style for the top-left corner button */
    background-color: #4a4a4a;
    border: 1px solid #555555;
}


/* List Widget (if used, less detailed than table for now) */
QListWidget {
    background-color: #3c3c3c;
    color: #f0f0f0;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 2px;
    font-size: 10pt;
}
QListWidget::item {
    padding: 5px;
}
QListWidget::item:selected {
    background-color: #007bff; /* Printago blue for selection */
    color: #ffffff;
}
QListWidget::item:hover {
    background-color: #4a4a4a; /* Subtle hover */
}

/* ScrollBars */
QScrollBar:vertical {
    background: #2d2d2d;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border: 1px solid #444;
}
QScrollBar::handle:vertical {
    background: #555555;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}
QScrollBar:horizontal {
    background: #2d2d2d;
    height: 12px;
    margin: 0px 0px 0px 0px;
    border: 1px solid #444;
}
QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

/* Status Bar */
QStatusBar {
    background-color: #1e1e1e; /* Very dark, almost black */
    color: #f0f0f0;
    border-top: 1px solid #444444;
    font-size: 9pt;
}
QStatusBar::item {
    border: none; /* Remove borders from items in status bar */
}

/* ToolBar */
QToolBar {
    background-color: #383838; /* Slightly lighter than main window for definition */
    border-bottom: 1px solid #444444;
    padding: 2px;
    spacing: 3px; /* Spacing between actions */
}
QToolBar QToolButton { /* Styling for buttons added via QAction */
    color: #f0f0f0;
    background-color: transparent; /* Make toolbar buttons flat by default */
    border: 1px solid transparent;
    padding: 4px 8px;
    font-size: 10pt;
}
QToolBar QToolButton:hover {
    background-color: #4a4a4a; /* Hover effect */
    border: 1px solid #555555;
}
QToolBar QToolButton:pressed {
    background-color: #555555;
}
QToolBar QToolButton:checked { /* For checkable actions */
    background-color: #007bff;
    color: #ffffff;
    border: 1px solid #0056b3;
}
QToolBar::separator {
    height: 1px;
    background-color: #555555;
    margin-left: 4px;
    margin-right: 4px;
}


/* QMessageBox (Dialogs) */
QMessageBox {
    background-color: #333333; /* Dark background for message boxes */
    /* Message box text color is often handled by system or QLabel styling */
}
QMessageBox QLabel { /* Specifically target QLabel within QMessageBox if needed */
    color: #f0f0f0;
    background-color: transparent;
}
QMessageBox QPushButton { /* Buttons within QMessageBox */
    min-width: 70px; /* Ensure buttons are not too small */
    /* background-color: #007bff; */ /* Already defined generally */
    /* color: #ffffff; */
}

/* StackedWidget - usually transparent, showing its current widget's background */
QStackedWidget {
    background-color: transparent;
}
